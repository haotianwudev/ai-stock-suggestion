# Server Configuration
PORT=4000

# Database Configuration (existing market-data Postgres)
DB_USER=your_username
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_password
DB_PORT=5432

# Supabase (auth + forum) — separate database and project from the above
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_USER=app_server
SUPABASE_DB_HOST=your-project-ref.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Frontend URL — used to build Stripe Checkout success/cancel redirect URLs.
# Local dev: http://localhost:3000. Production: the deployed client URL.
FRONTEND_URL=http://localhost:3000

# Stripe (donations)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4000/webhooks/stripe` in dev,
# or the signing secret of the webhook endpoint configured in the Stripe
# Dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_...
